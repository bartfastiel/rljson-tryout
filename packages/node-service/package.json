{
  "name": "@rljson-tryout/node-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --sourcemap --outfile=dist/main.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@rljson-tryout/domain": "workspace:*",
    "@rljson/bs": "0.0.26",
    "@rljson/db": "0.0.42",
    "@rljson/io": "0.0.78",
    "@rljson/io-sqlite-node": "1.0.7",
    "@rljson/network": "0.0.21",
    "@rljson/rljson": "0.0.81",
    "@rljson/server": "0.0.64",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "esbuild": "^0.28.2"
  }
}
